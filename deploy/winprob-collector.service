[Unit]
Description=Sleeper win probability collector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=winprob
WorkingDirectory=/opt/sleeper-winprob
# Keep memory small on a 1 GB droplet: a smaller JS heap makes Node clean up sooner.
ExecStart=/usr/bin/node --max-old-space-size=96 collector.js
MemoryHigh=200M
MemoryMax=300M
Restart=always
RestartSec=5
# The collector only needs to write its database.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/sleeper-winprob/data

[Install]
WantedBy=multi-user.target
