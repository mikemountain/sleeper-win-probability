[Unit]
Description=Sleeper win probability website
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=winprob
WorkingDirectory=/opt/sleeper-winprob
# Local-only port for nginx to proxy.
Environment=HOST=127.0.0.1
Environment=PORT=3017
# Keep memory small on a 1 GB droplet: a smaller JS heap makes Node clean up sooner.
ExecStart=/usr/bin/node --max-old-space-size=128 server.js
MemoryHigh=250M
MemoryMax=350M
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
# SQLite needs write access next to the database even to read it.
ReadWritePaths=/opt/sleeper-winprob/data

[Install]
WantedBy=multi-user.target
